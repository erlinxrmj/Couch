<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient android:angle="0" android:startColor="#B38B5CF6" android:endColor="#B3EC4899" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="22dp" /></shape>
    </item>
</selector>
